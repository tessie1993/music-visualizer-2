+    // rejects GL_BACK with GL_INVALID_OPERATION (latching an error every
+    // frame), and a lenient one redirects the final copy away from the
+    // caller's texture - a permanently black output. Select per target.
+    GLenum backBuf = targetFramebufferObject == 0 ? GL_BACK : GL_COLOR_ATTACHMENT0;
     glDrawBuffers(1, &backBuf);

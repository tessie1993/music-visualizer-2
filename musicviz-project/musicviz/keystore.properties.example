# Copy to keystore.properties (git-ignored) to sign local release builds.
#
# Generate the upload key once, then keep the .jks and these passwords safe —
# losing them means asking Google to reset the upload key:
#
#   keytool -genkeypair -v -keystore musicviz-upload.jks \
#     -alias musicviz -keyalg RSA -keysize 4096 -validity 10000
#
# CI reads the same values from the MUSICVIZ_KEYSTORE,
# MUSICVIZ_KEYSTORE_PASSWORD, MUSICVIZ_KEY_ALIAS and MUSICVIZ_KEY_PASSWORD
# environment variables instead.

storeFile=/absolute/path/to/musicviz-upload.jks
storePassword=
keyAlias=musicviz
keyPassword=

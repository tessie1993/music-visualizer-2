# Copy to keystore.properties (git-ignored) to sign local release builds.
#
# Generate the upload key once, then keep the .jks and these passwords safe —
# losing them means asking Google to reset the upload key:
#
#   keytool -genkeypair -v -keystore geode-upload.jks \
#     -alias geode -keyalg RSA -keysize 4096 -validity 10000
#
# CI reads the same values from the GEODE_KEYSTORE, GEODE_KEYSTORE_PASSWORD,
# GEODE_KEY_ALIAS and GEODE_KEY_PASSWORD environment variables instead. In
# .github/workflows/release.yml those are filled from the repository secrets,
# which keep their older MUSICVIZ_ names.

storeFile=/absolute/path/to/geode-upload.jks
storePassword=
keyAlias=geode
keyPassword=

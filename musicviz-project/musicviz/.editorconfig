root = true

[*.{kt,kts}]
# Stated explicitly so a plugin upgrade cannot reinterpret it. This tree is
# written in ktlint_official - trailing commas, one parameter per line, wrapped
# function signatures - which is also ktlint 1.x's own default; leaving it
# unstated is what let the question come up at all.
ktlint_code_style = ktlint_official
ktlint_function_naming_ignore_when_annotated_with = Composable

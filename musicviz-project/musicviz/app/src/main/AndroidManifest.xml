<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- "Live input": the visuals react to the room instead of to a track.
         Requested at the moment the user turns that setting on, never at
         launch; samples go straight into the analysis ring buffer and are
         never written to disk or sent anywhere. The feature is optional, so
         the microphone is not a required device feature. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!-- "Visualize other apps": Android 10's playback-capture API, which the
         platform only allows from a foreground service the user can see. The
         notification is the point, not a formality — it is the standing
         statement that this app can currently hear the device — so
         POST_NOTIFICATIONS is requested at the moment the feature is turned
         on. Nothing captured is written to disk or sent anywhere; the samples
         go into the same in-memory analysis ring buffer the microphone and
         the player already share. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The live wallpaper is optional; the app is fully usable without a
         launcher that supports one. -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <application
        android:name=".MusicVizApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MusicViz.Splash"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Shared presets. A preset is a self-contained document and the app
              has no network permission, so a "shared preset" IS the preset,
              carried inside the link; tapping one in a chat opens the app and
              imports it. Nothing is fetched.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="musicviz"
                    android:host="preset" />
            </intent-filter>
        </activity>

        <!--
          The visualizer as a live wallpaper: the same renderer, on the style
          and parameters the app was last left showing. It reacts to what the
          app is playing and breathes on its own the rest of the time.
        -->
        <service
            android:name=".wallpaper.VisualizerWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!--
          Playback capture: holds the MediaProjection and the ongoing
          notification for as long as another app's audio is being read.
          Not exported — it is started only by this app, with consent the user
          just gave to the system dialog.
        -->
        <service
            android:name=".audio.PlaybackCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          Does nothing, and must exist: getActiveSessions() is gated on being
          an enabled notification listener, and that is the only way to become
          one. It is how the app can name what Spotify or YouTube is playing.
          Optional — the visuals work on the captured audio alone.
        -->
        <service
            android:name=".audio.MusicVizNotificationListener"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Sharing a preset too long to be a link sends its .json; a raw
             file:// uri cannot leave the app, so it goes out through here.
             Scoped to the presets directory alone (preset_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.presets"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/preset_paths" />
        </provider>
    </application>
</manifest>

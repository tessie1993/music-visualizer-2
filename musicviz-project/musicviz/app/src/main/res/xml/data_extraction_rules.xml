<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (cloud backup and device-to-device transfer). Same shape as
     backup_rules.xml: keep user-authored data, drop the rebuildable cache and
     the crash file. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="analysis" />
        <exclude
            domain="file"
            path="crash-latest.txt" />
        <exclude
            domain="file"
            path="milk/generated" />
        <!-- User-imported texture images are large and re-importable; left
             in, they push the total past the cloud quota and backup of
             EVERYTHING (presets, playlists, history) silently stops. -->
        <exclude
            domain="file"
            path="milk/textures" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="crash-latest.txt" />
    </device-transfer>
</data-extraction-rules>

per_frame_1=vol = 0.5*bass_att + 0.3*mid_att + 0.2*treb_att;
per_frame_2=zoom = 1.008 + 0.030*bass_att;
per_frame_3=rot = 0.012*sin(time*0.21) + 0.010*mid_att;
per_frame_4=warp = 0.010 + 0.045*treb_att;
per_frame_5=decay = 0.965 + 0.020*(1 - min(1, bass_att));
per_frame_6=wave_r = 0.55 + 0.40*sin(time*0.31);
per_frame_7=wave_g = 0.55 + 0.40*sin(time*0.37 + 2.1);
per_frame_8=wave_b = 0.55 + 0.40*sin(time*0.29 + 4.2);
per_frame_9=wave_a = 0.35 + 0.55*vol;
per_frame_10=ib_a = 0.05 + 0.25*bass_att;
per_pixel_1=zoom = zoom + 0.020*cos(rad*9 - time*1.1)*bass_att;
per_pixel_2=rot = rot + 0.020*rad*mid_att;

per_frame_1=dx = 0.0018*sin(time*0.17) + 0.0026*mid_att;
per_frame_2=dy = 0.0012*cos(time*0.13);
per_frame_3=zoom = 1.002 + 0.010*bass_att;
per_frame_4=warp = 0.008 + 0.030*mid_att;
per_frame_5=rot = 0.004*sin(time*0.09);
per_frame_6=wave_r = 0.30 + 0.55*treb_att;
per_frame_7=wave_g = 0.50 + 0.35*sin(time*0.23);
per_frame_8=wave_b = 0.75 - 0.25*bass_att;
per_frame_9=wave_a = 0.30 + 0.50*mid_att;
per_pixel_1=dx = dx + 0.0030*sin(y*6.2 + time*0.8)*mid_att;
per_pixel_2=dy = dy + 0.0022*cos(x*5.4 - time*0.6)*treb_att;

per_frame_1=beat = max(0, bass_att - 1.05);
per_frame_2=zoom = 1.004 + 0.070*beat;
per_frame_3=rot = 0.030*beat*sin(time*3.1);
per_frame_4=warp = 0.020 + 0.090*beat + 0.030*treb_att;
per_frame_5=decay = 0.950 + 0.030*(1 - min(1, beat*3));
per_frame_6=wave_r = 0.95;
per_frame_7=wave_g = 0.35 + 0.55*beat;
per_frame_8=wave_b = 0.20 + 0.70*treb_att;
per_frame_9=wave_a = 0.30 + 0.60*beat;
per_frame_10=ib_a = 0.30*beat;
per_pixel_1=warp = warp + 0.060*sin(ang*7 + time*2.0)*bass_att;
per_pixel_2=zoom = zoom + 0.030*cos(ang*4 - time*1.3)*treb_att;
